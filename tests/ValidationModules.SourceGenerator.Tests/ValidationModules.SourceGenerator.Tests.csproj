<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>False</IsPackable>
        <RootNamespace>ValidationModules.SourceGenerator.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- Referenced as a library, not an analyzer: these tests drive the generator directly. -->
        <ProjectReference Include="..\..\src\ValidationModules.SourceGenerator\ValidationModules.SourceGenerator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="true"/>
        <ProjectReference Include="..\..\src\ValidationModules.Runtime\ValidationModules.Runtime.csproj"/>
    </ItemGroup>

    <!--
        The runtime package's props carries the contract version for MSBuild hosts that have no
        compilation to read the constant from. Copied here so RuntimeContractTests can assert the
        two never drift.
    -->
    <ItemGroup>
        <None Include="..\..\src\ValidationModules.Runtime\Package\ValidationModules.Runtime.props"
              Link="ValidationModules.Runtime.props"
              CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <!--
        Golden files for the emitters. Read from the build output so the tests do not depend on
        source paths, which deterministic builds rewrite to /_/... The source location is injected
        separately and used only when UPDATE_SNAPSHOTS=1.
    -->
    <ItemGroup>
        <Content Include="Snapshots\**\*.verified.txt" CopyToOutputDirectory="PreserveNewest" LinkBase="Snapshots"/>
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>SnapshotDirectory</_Parameter1>
            <_Parameter2>$(MSBuildProjectDirectory)/Snapshots</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.10.0"/>

        <!-- The concrete container, so the documentation samples can build a provider like a reader would. -->
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3" Version="3.2.2"/>
        <PackageReference Include="coverlet.collector" Version="6.0.2">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!--
        The documentation samples are compiled from source, so the tests need to find website/.
        Injected rather than walked up from the binary, because deterministic builds rewrite paths.
    -->
    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>RepositoryRoot</_Parameter1>
            <_Parameter2>$(MSBuildProjectDirectory)/../..</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
