<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>False</IsPackable>
        <RootNamespace>ValidationModules.Runtime.Tests</RootNamespace>
    </PropertyGroup>

    <!-- Options is referenced only so its public surface can be pinned here alongside the others.
         It ships a referenceable assembly, so a signature change is a binary break for a consumer
         that upgrades the package without recompiling against it. -->
    <ItemGroup>
        <ProjectReference Include="..\..\src\ValidationModules.Runtime\ValidationModules.Runtime.csproj"/>
        <ProjectReference Include="..\..\src\ValidationModules.Options\ValidationModules.Options.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.2">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="PublicApiGenerator" Version="11.5.4"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0"/>
        <PackageReference Include="NSubstitute" Version="5.3.0"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3" Version="3.2.2"/>
    </ItemGroup>

    <!-- Framework-matched, tracking what the runtime resolves for the same TFM. A flat 8.0.x here
         is a downgrade against the net10.0 leg, which NU1605 treats as an error. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0"/>
    </ItemGroup>

    <!--
        Snapshots are read from the build output so the tests do not depend on source paths,
        which deterministic builds rewrite to /_/... The source location is injected separately
        and used only when UPDATE_SNAPSHOTS=1.
    -->
    <ItemGroup>
        <Content Include="Snapshots\**\*.verified.txt" CopyToOutputDirectory="PreserveNewest" LinkBase="Snapshots"/>
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>SnapshotDirectory</_Parameter1>
            <_Parameter2>$(MSBuildProjectDirectory)/Snapshots</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

    <!--
        The documentation-coverage tests cross-check both public API snapshots against website/.
        Injected rather than walked up from the binary, because deterministic builds rewrite paths.
    -->
    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>RepositoryRoot</_Parameter1>
            <_Parameter2>$(MSBuildProjectDirectory)/../..</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
