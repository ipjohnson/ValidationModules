<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>False</IsPackable>
        <RootNamespace>ValidationModules.AspNetCore.Tests</RootNamespace>

        <!-- The validated models live here, so the generator runs over this project. -->
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    </PropertyGroup>

    <!--
        The plain SDK with an explicit framework reference, not Microsoft.NET.Sdk.Web. The Web SDK
        would supply the same reference and also generate an entry point, which collides with the
        one the test runner generates.
    -->
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\ValidationModules.AspNetCore\ValidationModules.AspNetCore.csproj"/>
        <ProjectReference Include="..\..\src\ValidationModules.Runtime\ValidationModules.Runtime.csproj"/>
        <ProjectReference Include="..\..\src\ValidationModules.SourceGenerator\ValidationModules.SourceGenerator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.2">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3" Version="3.2.2"/>
        <PackageReference Include="PublicApiGenerator" Version="11.5.4"/>
    </ItemGroup>

    <!--
        The snapshot helper is linked rather than duplicated: two copies of an approval harness
        agree only until somebody edits one. Same reason RuleText.cs is linked into the generator.
    -->
    <ItemGroup>
        <Compile Include="..\ValidationModules.Runtime.Tests\Infrastructure\Snapshot.cs"
                 Link="Infrastructure\Snapshot.cs"/>
    </ItemGroup>

    <!-- See ValidationModules.Runtime.Tests: read from the output, updated through the source path. -->
    <ItemGroup>
        <Content Include="Snapshots\**\*.verified.txt" CopyToOutputDirectory="PreserveNewest" LinkBase="Snapshots"/>
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>SnapshotDirectory</_Parameter1>
            <_Parameter2>$(MSBuildProjectDirectory)/Snapshots</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.11"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0"/>
    </ItemGroup>

</Project>
