<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\ValidationModules.Runtime\ValidationModules.Runtime.csproj"/>
        <ProjectReference Include="..\..\src\ValidationModules.SourceGenerator\ValidationModules.SourceGenerator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <!--
        Both DependencyModules packages, so this project exercises the branch SutProject cannot:
        the generator sees IDependencyModule in the compilation and emits a module instead of a
        static table. It also proves the two generators coexist - ours deliberately does not host
        DM's attribute stages, and if it did, [DependencyModule] would be processed twice here.
    -->
    <ItemGroup>
        <PackageReference Include="DependencyModules.Runtime" Version="1.2.0"/>
        <PackageReference Include="DependencyModules.SourceGenerator" Version="1.2.0" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0"/>
    </ItemGroup>

</Project>
