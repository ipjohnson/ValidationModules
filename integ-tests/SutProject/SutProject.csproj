<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!--
            The point of this project: it compiles what the generator emitted. Golden-file tests
            prove the text is what was expected; only a real compilation proves it is valid C#
            that binds against the runtime the consumer actually references.
        -->
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
    </PropertyGroup>

    <!--
        The internal-model tests live in the test assembly, and an internal validator is only
        reachable from there with this. That the tests need it at all is the point: without it they
        fail to compile, which is what proves the emitted class really is internal.
    -->
    <ItemGroup>
        <InternalsVisibleTo Include="SutProject.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\ValidationModules.Runtime\ValidationModules.Runtime.csproj"/>
        <ProjectReference Include="..\..\src\ValidationModules.SourceGenerator\ValidationModules.SourceGenerator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

</Project>
