<Project>

    <!--
        Single source of truth for the product version.
        Release builds override PackageVersion (see .github/workflows/release.yaml, which computes
        1.0.0-rc(1000 + run number)); local and CI builds fall back to the values below.

        On the 1.0.0 release-candidate line, matching DependencyModules' own 1.0.0-rc* stream.
        Stage 4 has shipped, so IMPLEMENTATION-PLAN.md §7.5's emitted-surface promise now has
        something to promise - and RuntimeContract is what actually versions that surface, rather
        than this number.
    -->
    <PropertyGroup>
        <VersionPrefix>1.0.0</VersionPrefix>
        <!--
            rc0 for a local build, so it sorts below every published rc(1000+n). A release supplies
            its own version, so this default never reaches nuget.org.

            This used to say that a stable release was blocked outright, because
            DependencyModules.SourceGenerator.Impl publishes only as 1.0.0-rc* and NU5104 rejects a
            stable package with a prerelease dependency. Packing all four at 1.0.0 shows that is
            true of one of them:

              Runtime, AspNetCore, SourceGenerator   clean - the DM reference is PrivateAssets=all
                                                     on the generator, so it is not in the nuspec
              SourceGenerator.Impl                   NU5104, because a source-only package's
                                                     dependencies are the point of it

            The three packages a consumer installs can ship stable whenever we like. Impl carries a
            targeted NoWarn for the one warning, since a framework author compiling those sources in
            is opting into DM's own prerelease anyway. Drop that suppression - not the dependency -
            once DependencyModules publishes a stable version.
        -->
        <VersionSuffix Condition="'$(VersionSuffix)' == ''">rc0</VersionSuffix>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
    </PropertyGroup>

    <!--
        The shipping libraries' target frameworks, in one place. net8.0 leaves support in November
        2026, and dropping it should then be a one-line edit here rather than a sweep through every
        csproj. The generator projects are deliberately not covered: a Roslyn analyzer has to target
        netstandard2.0 and pins its own TFM.
    -->
    <PropertyGroup>
        <LibraryTargetFrameworks>net8.0;net10.0</LibraryTargetFrameworks>
    </PropertyGroup>

    <PropertyGroup>
        <Authors>Ian Johnson</Authors>
        <Company>Ian Johnson</Company>
        <Copyright>Copyright (c) Ian Johnson</Copyright>
        <PackageProjectUrl>https://github.com/ipjohnson/ValidationModules</PackageProjectUrl>
        <RepositoryUrl>https://github.com/ipjohnson/ValidationModules</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>validation;source-generator;roslyn;aot;native-aot;trimming;servicecollection</PackageTags>
        <PackageReleaseNotes>https://github.com/ipjohnson/ValidationModules/releases</PackageReleaseNotes>
    </PropertyGroup>

    <!-- Deterministic, source-linked builds so consumers can step into the library. -->
    <PropertyGroup>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
        <TreatWarningsAsErrors Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</TreatWarningsAsErrors>
    </PropertyGroup>

</Project>
