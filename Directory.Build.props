<Project>

    <!--
        Single source of truth for the product version.
        Release builds override PackageVersion (see .github/workflows/release.yaml, which computes
        an rc from the run number, or takes a stable version typed into the dispatch); local and CI
        builds fall back to the values below.

        On the 1.1.0 line. 1.0.0 shipped stable, and 1.1.0 adds VM6001 and changes where the
        DependencyModules branch registers - additive to the API surface and to what a consumer
        calls, which is what makes it a minor rather than a major.
        RuntimeContract is what versions the emitted surface, rather than this number. It stays at
        11: the new registration calls nothing the runtime did not already offer.
    -->
    <PropertyGroup>
        <VersionPrefix>1.1.0</VersionPrefix>
        <!--
            rc0 for a local build, so it sorts below every published rc(1000+n). A release supplies
            its own version, so this default never reaches nuget.org.

            Nothing holds a stable release back any more. This used to record the problem in two
            rounds: first that a stable version was impossible at all, because
            DependencyModules.SourceGenerator.Impl published only as 1.0.0-rc* and NU5104 rejects a
            stable package with a prerelease dependency; then that only SourceGenerator.Impl was
            affected, the other three carrying the DM reference as PrivateAssets=all so it never
            reaches their nuspec, with Impl holding a targeted NoWarn until DM went stable.

            DependencyModules 1.0.0 has now shipped. Every DM reference is pinned to it and the
            NU5104 suppression is deleted, so all four pack clean at a stable version with nothing
            suppressed.
        -->
        <VersionSuffix Condition="'$(VersionSuffix)' == ''">rc0</VersionSuffix>
        <AssemblyVersion>1.1.0.0</AssemblyVersion>
        <FileVersion>1.1.0.0</FileVersion>
    </PropertyGroup>

    <!--
        The shipping libraries' target frameworks, in one place. net8.0 leaves support in November
        2026, and dropping it should then be a one-line edit here rather than a sweep through every
        csproj. The generator projects are deliberately not covered: a Roslyn analyzer has to target
        netstandard2.0 and pins its own TFM.
    -->
    <PropertyGroup>
        <LibraryTargetFrameworks>net8.0;net10.0</LibraryTargetFrameworks>
    </PropertyGroup>

    <PropertyGroup>
        <Authors>Ian Johnson</Authors>
        <Company>Ian Johnson</Company>
        <Copyright>Copyright (c) Ian Johnson</Copyright>
        <PackageProjectUrl>https://github.com/ipjohnson/ValidationModules</PackageProjectUrl>
        <RepositoryUrl>https://github.com/ipjohnson/ValidationModules</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <PackageTags>validation;source-generator;roslyn;aot;native-aot;trimming;servicecollection</PackageTags>
        <PackageReleaseNotes>https://github.com/ipjohnson/ValidationModules/releases</PackageReleaseNotes>
    </PropertyGroup>

    <!-- Deterministic, source-linked builds so consumers can step into the library. -->
    <PropertyGroup>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
        <TreatWarningsAsErrors Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</TreatWarningsAsErrors>
    </PropertyGroup>

</Project>
