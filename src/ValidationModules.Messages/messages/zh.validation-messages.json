{
    "culture": "zh",
    "templates": {
        "required": "{field}为必填项。",
        "string_length.between": "{field}的长度必须介于{0}到{1}个字符之间。",
        "string_length.between_singular": "{field}的长度必须介于{0}到{1}个字符之间。",
        "string_length.at_most": "{field}的长度不能超过{0}个字符。",
        "string_length.at_most_singular": "{field}的长度不能超过{0}个字符。",
        "string_length.at_least": "{field}的长度不能少于{0}个字符。",
        "string_length.at_least_singular": "{field}的长度不能少于{0}个字符。",
        "array_bounds.between": "{field}必须包含{0}到{1}个项目。",
        "array_bounds.between_singular": "{field}必须包含{0}到{1}个项目。",
        "array_bounds.at_most": "{field}最多只能包含{0}个项目。",
        "array_bounds.at_most_singular": "{field}最多只能包含{0}个项目。",
        "array_bounds.at_least": "{field}至少要包含{0}个项目。",
        "array_bounds.at_least_singular": "{field}至少要包含{0}个项目。",
        "range.between": "{field}必须介于{0}和{1}之间。",
        "range.greater_and_at_most": "{field}必须大于{0}且不超过{1}。",
        "range.at_least_and_less": "{field}必须不小于{0}且小于{1}。",
        "range.greater_and_less": "{field}必须大于{0}且小于{1}。",
        "range.at_least": "{field}不能小于{0}。",
        "range.greater_than": "{field}必须大于{0}。",
        "range.at_most": "{field}不能大于{0}。",
        "range.less_than": "{field}必须小于{0}。",
        "multiple_of": "{field}必须是{0}的倍数。",
        "unique_items": "{field}不能包含重复的项目。",
        "pattern": "{field}的格式不正确。",
        "enum": "{field}必须是以下值之一：{0}。",
        "enum.denied": "{field}不能是以下值：{0}。",
        "enum.flags": "{field}必须是以下值的组合：{0}。",
        "email": "{field}不是有效的电子邮件地址。",
        "phone": "{field}不是有效的电话号码。",
        "url": "{field}不是有效的 http、https 或 ftp 网址。",
        "credit_card": "{field}不是有效的卡号。",
        "base64": "{field}不是有效的 Base64 字符串。",
        "file_extension": "{field}的扩展名必须是：{0}。",
        "custom": "{field}无效。",
        "date_order": "结束日期不能早于开始日期。"
    }
}
