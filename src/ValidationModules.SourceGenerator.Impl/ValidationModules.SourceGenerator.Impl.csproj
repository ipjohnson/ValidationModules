<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>10</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsPackable>True</IsPackable>
        <Nullable>enable</Nullable>
        <PackageId>ValidationModules.SourceGenerator.Impl</PackageId>
        <Description>Source-only package containing the ValidationModules generator internals: the validated-type IR, the attribute and DataAnnotations front-ends, and the validator and registration emitters. Set PackageValidationModulesIncludeSource=true to compile these into your own Roslyn generator and drive the same emitter from your own front-end. Most projects want ValidationModules.SourceGenerator instead.</Description>
        <DevelopmentDependency>true</DevelopmentDependency>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <!-- Source-only package: ships .cs under src/ and no lib/, which is exactly what NU5128 flags. -->
        <!--
            RS2000 for the DM#### rules. DependencyModules' diagnostics arrive with its source
            import and are tracked in that project's own AnalyzerReleases files; listing them in
            ours would claim them as this package's. The VM#### rules are tracked normally.

            NU5104 used to be suppressed here. This is the one package that cannot hide a
            dependency behind PrivateAssets - a source-only package's dependencies are the point of
            it - and DependencyModules.SourceGenerator.Impl published only as 1.0.0-rc*, which
            NU5104 rejects under a stable version. DependencyModules ships stable now and the
            reference below is pinned to a stable release, so the suppression is deleted rather than carried: if a
            prerelease DM dependency ever returns, that should be a warning again rather than
            something a stale NoWarn hides.
        -->
        <NoWarn>$(NoWarn);NU5128;RS2000;RS2008</NoWarn>
    </PropertyGroup>

    <!--
        DependencyModules' own generator internals and CSharpAuthor are compiled in from their
        packages rather than vendored. Both ship as source-only packages gated on a property, which
        is the same mechanism this package offers its own consumers.
    -->
    <PropertyGroup>
        <PackageDependencyModuleIncludeSource>true</PackageDependencyModuleIncludeSource>
        <PackageCSharpAuthorIncludeSource>true</PackageCSharpAuthorIncludeSource>
        <!-- The ITypeSymbol -> ITypeDefinition bridge, so the one Roslyn-coupled emitter can hand
             a symbol to the type model instead of parsing its display string. -->
        <PackageCSharpAuthorIncludeRoslyn>true</PackageCSharpAuthorIncludeRoslyn>
    </PropertyGroup>

    <ItemGroup>
        <!-- PackagePath must use a forward slash: a trailing backslash packs to "build//" on Linux/macOS,
             which breaks NuGet's build/$(PackageId).props|targets convention. -->
        <None Remove="Package\ValidationModules.*"/>
        <Content Include="Package\ValidationModules.*">
            <Pack>true</Pack>
            <PackagePath>build/</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </Content>
        <Content Include="**\*.cs" Exclude="**\obj\**;**\bin\**" Visible="true">
            <Pack>true</Pack>
            <PackagePath>src/ValidationModules.SourceGenerator.Impl/</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </Content>
    </ItemGroup>

    <!--
        RuleText lives in the runtime and is compiled in here as well, rather than reimplemented.
        The predicate text contract rests on the generated validator and DescribedValidator<T> rendering the
        same predicate to the same string; two copies of that transform would agree only until
        somebody edited one of them. It is packed explicitly because the glob above only reaches
        files under this project.
    -->
    <ItemGroup>
        <Compile Include="..\ValidationModules.Runtime\Rules\RuleText.cs" Link="FrontEnds\RuleText.cs"/>
        <Content Include="..\ValidationModules.Runtime\Rules\RuleText.cs" Visible="false">
            <Pack>true</Pack>
            <PackagePath>src/ValidationModules.SourceGenerator.Impl/FrontEnds/RuleText.cs</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </Content>
    </ItemGroup>

    <!-- These deps intentionally flow: consumers compile the shipped sources into their own generator. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.10.0"/>
        <PackageReference Include="DependencyModules.SourceGenerator.Impl" Version="1.2.0"/>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!--
            1.1.1010 rather than 1.1.1007 because DependencyModules 1.0.0's InterceptorFileWriter
            uses CSharpAuthor's ConstraintDefinition, which 1.1.1010 introduced. DM does not declare
            a CSharpAuthor dependency - both are source-only packages compiled in side by side, so
            the version that satisfies DM's sources is this project's problem to get right, and
            nothing in the restore graph will raise it for us.
        -->
        <PackageReference Include="CSharpAuthor" Version="2.0.0-preview1005">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>build</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- Release tracking for the VM#### diagnostics (RS2008). -->
    <ItemGroup>
        <AdditionalFiles Include="AnalyzerReleases.Shipped.md"/>
        <AdditionalFiles Include="AnalyzerReleases.Unshipped.md"/>
    </ItemGroup>

</Project>
