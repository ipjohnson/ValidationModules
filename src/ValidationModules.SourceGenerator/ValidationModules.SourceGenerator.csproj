<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>11</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <Nullable>enable</Nullable>
        <IsPackable>True</IsPackable>
        <PackageId>ValidationModules.SourceGenerator</PackageId>
        <Description>Roslyn source generator for ValidationModules. Flattens [Required], [StringLength], [Range], [Pattern] and the rest - plus System.ComponentModel.DataAnnotations equivalents - into straight-line validators at compile time, with no reflection, expression trees or runtime-compiled regex. Pair with the ValidationModules.Runtime package.</Description>
        <DevelopmentDependency>true</DevelopmentDependency>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <!-- Analyzer package: ships a single analyzer assembly and no lib/, which is exactly what NU5128 flags. -->
        <!--
            RS2000 for the DM#### rules. DependencyModules' diagnostics arrive with its source
            import and are tracked in that project's own AnalyzerReleases files; listing them in
            ours would claim them as this package's. The VM#### rules are tracked normally.
        -->
        <NoWarn>$(NoWarn);NU5128;RS2000;RS2008</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <PackageDependencyModuleIncludeSource>true</PackageDependencyModuleIncludeSource>
        <PackageCSharpAuthorIncludeSource>true</PackageCSharpAuthorIncludeSource>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="Package\ValidationModules.SourceGenerator.*">
            <Pack>true</Pack>
            <PackagePath>build/</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </Content>
    </ItemGroup>

    <!-- Roslyn supplies these to the analyzer at load time; they must not flow to consumers. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.10.0" PrivateAssets="all"/>
        <PackageReference Include="DependencyModules.SourceGenerator.Impl" Version="1.0.0" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="CSharpAuthor" Version="1.1.1007">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>build</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
    </ItemGroup>

    <!--
        The Impl sources are compiled in rather than referenced, so the analyzer ships as one
        assembly. This is also the arrangement a framework author reproduces: compile Impl in, get
        every stage, and get no [Generator] entry point - the only one lives in this project and is
        deliberately not packed into Impl, which is how double registration is avoided.
    -->
    <ItemGroup>
        <Compile Include="../ValidationModules.SourceGenerator.Impl/**/*.cs"
                 Exclude="../ValidationModules.SourceGenerator.Impl/obj/**/*;../ValidationModules.SourceGenerator.Impl/bin/**/*">
            <Link>Impl\%(RecursiveDir)/%(FileName)%(Extension)</Link>
        </Compile>

        <!--
            RuleText lives in the runtime and Impl compiles it in from there, so the glob above -
            which only sees Impl's own directory - misses it. Restated here for the same reason it is
            restated in Impl: one implementation of the predicate render, not two that agree until
            somebody edits one. API-SURFACE.md §19.5.
        -->
        <Compile Include="../ValidationModules.Runtime/Rules/RuleText.cs" Link="Impl\FrontEnds\RuleText.cs"/>
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="../ValidationModules.SourceGenerator.Impl/AnalyzerReleases.Shipped.md"/>
        <AdditionalFiles Include="../ValidationModules.SourceGenerator.Impl/AnalyzerReleases.Unshipped.md"/>
    </ItemGroup>

</Project>
