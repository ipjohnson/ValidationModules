<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>True</IsPackable>
        <PackageId>ValidationModules.Runtime</PackageId>
        <Description>Runtime support for ValidationModules: constraint attributes, the IValidatorFor&lt;T&gt; contracts, the validation context and error model, and IServiceCollection extensions. Pair with the ValidationModules.SourceGenerator package, which flattens the attributes into straight-line validators at build time.</Description>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!--
            The package is ValidationModules.Runtime; the namespace is ValidationModules. Consumers
            write `using ValidationModules;` and get the contracts, which is what
            IMPLEMENTATION-PLAN.md §4 specifies. Constraint attributes deliberately live one level
            down in ValidationModules.Constraints - see API-SURFACE.md §1 for why that separation
            is load-bearing rather than tidiness.
        -->
        <RootNamespace>ValidationModules</RootNamespace>

        <!--
            The reason this library exists. Every IL* warning is an error here: each one is a call
            the trimmer or the AOT compiler cannot follow, and the incumbent's trim warnings under
            Native AOT are precisely the gap this fills. Enforced by the compiler rather than by
            review - see IMPLEMENTATION-PLAN.md §2.
        -->
        <IsAotCompatible>true</IsAotCompatible>
        <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2055;IL2067;IL2072;IL2075;IL2087;IL3050</WarningsAsErrors>
    </PropertyGroup>

    <!--
        Framework-matched rather than one 8.0.0 reference serving both. On net10.0 these
        abstractions are part of the ASP.NET Core shared framework, and pinning the 8.0.0 package
        there puts an older assembly in the consumer's output in place of the one the framework
        already supplies. Each TFM takes its own framework's baseline version, so a consumer rolls
        forward from it rather than being dragged back to it.
    -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ValidationModules.Runtime.Tests"/>
    </ItemGroup>

    <!--
        PackagePath must use a forward slash: a trailing backslash packs to "build//" on Linux and
        macOS, which breaks NuGet's build/$(PackageId).props convention.
    -->
    <ItemGroup>
        <None Remove="Package\ValidationModules.Runtime.*"/>
        <Content Include="Package\ValidationModules.Runtime.*">
            <Pack>true</Pack>
            <PackagePath>build/</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </Content>
    </ItemGroup>

</Project>
